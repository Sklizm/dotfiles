{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/home/codrin/.config/fastfetch/tree.txt",
        "type": "file",
        "color": {
            "1": "green",
            "2": "yellow",
            "3": "magenta"
        },
        "padding": { "top": 1, "left": 1, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "green",
            "title": "green"
        }
    },
    "modules": [
        "break",
        {
            "type": "title",
            "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}"
        },
        {
            "type": "custom",
            "format": "─────────────────────────────"
        },
        { "type": "os", "key": "  os" },
        { "type": "kernel", "key": "  kernel" },
        { "type": "packages", "key": "  packages" },
        { "type": "shell", "key": "  shell" },
        { "type": "terminal", "key": "  terminal" },
        { "type": "wm", "key": "  wm" },
        { "type": "de", "key": "  de" },
        { "type": "theme", "key": "  theme" },
        { "type": "icons", "key": "  icons" },
        { "type": "cursor", "key": "  cursor" },
        { "type": "font", "key": "  font" },
        {
            "type": "custom",
            "format": "─────────────────────────────"
        },
        { "type": "cpu", "key": "  cpu" },
        { "type": "gpu", "key": "  gpu" },
        { "type": "memory", "key": "  memory" },
        { "type": "disk", "key": "  disk" },
        { "type": "uptime", "key": "  uptime" },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        },
        "break"
    ]
}
